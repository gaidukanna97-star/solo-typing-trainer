# Потрібні лише серверній функції api/account.js на Vercel. Для локального запуску (npm start) не потрібні.
# Довгий випадковий рядок для підпису токенів сеансу: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOLO_SECRET=
# Токен приватного сховища Vercel Blob — додається автоматично командою: vercel blob create-store <назва> --access private
BLOB_READ_WRITE_TOKEN=
